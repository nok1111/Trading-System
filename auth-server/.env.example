# Alvora Auth Server — Environment Variables

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://alvora:alvora@localhost:5432/alvora_auth

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Binance Pay (Merchant)
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_MERCHANT_ID=

# CORS — comma-separated origins or * for all
# En desarrollo: * (permite cualquier origen)
# En producción: especificar los orígenes del trading client, ej:
# CORS_ORIGINS=http://76.13.180.80:8080,http://localhost:8080
CORS_ORIGINS=*

# App
APP_ENV=development
LOG_LEVEL=INFO
