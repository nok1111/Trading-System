# Alvora Trading Platform — Environment Variables

# ─── Trading Client ──────────────────────────────────────────────
# Auth server connection
AUTH_SERVER_URL=http://localhost:8001

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./alvora.db

# AI Provider keys
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# AI Provider selection (groq, gemini, ollama, remote)
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
OLLAMA_URL=http://localhost:11434

# Broker defaults
DEFAULT_BROKER_ID=binance

# Rate limiting (requests per minute)
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=info

# ─── Auth Server ─────────────────────────────────────────────────
# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 2FA
TOTP_ISSUER=Alvora

# Database
AUTH_DATABASE_URL=sqlite:///./auth.db

# ─── Desktop (Tauri) ─────────────────────────────────────────────
# The desktop app reads these from the system env or .env file
VITE_API_URL=http://localhost:8000
VITE_AUTH_URL=http://localhost:8001
