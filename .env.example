# Entorno de la aplicación: development, testing, staging, production
APP_ENV=development

# Base de datos (PostgreSQL recomendado, se puede usar SQLite para pruebas locales)
DATABASE_URL=postgresql+psycopg2://trading_user:trading_pass@db:5432/trading_db

# Broker (mock, paper, alpaca, ibkr, binance)
BROKER_PROVIDER=mock
BROKER_API_KEY=
BROKER_API_SECRET=

# Binance: usar testnet para pruebas sin dinero real
BINANCE_TESTNET=false

# Modo de operación: backtest, paper, live
TRADING_MODE=backtest

# ÚNICAMENTE activar en producción tras revisión manual y bajo tu propio riesgo
LIVE_TRADING_ENABLED=false

# Símbolos por defecto, separados por comas
# Para Binance usar pares crypto: BTCUSDT,ETHUSDT,SOLUSDT
DEFAULT_SYMBOLS=SPY,AAPL,MSFT

# Gestión de riesgo (porcentajes sobre capital o unidades)
MAX_POSITION_SIZE_PERCENT=10.0
MAX_RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=3.0
MIN_CASH_RESERVE_PERCENT=20.0
MAX_OPEN_POSITIONS=20
MAX_HOLD_SYMBOLS=8
MAX_ACTIVE_SYMBOLS=10
HOLD_STALE_TICKS=10
DEFAULT_STOP_LOSS_PERCENT=3.0
DEFAULT_TAKE_PROFIT_PERCENT=6.0

# Datos de mercado (timeframe: 1m, 5m, 15m, 1h, 4h, 1d)
DATA_TIMEFRAME=5m

# Paper trading (FASE 5)
PAPER_TRADING_ENABLED=false
PAPER_TRADING_INTERVAL_SECONDS=300
PAPER_TRADING_LOOKBACK_DAYS=60
PAPER_TRADING_INITIAL_CASH=100000.00

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Zona horaria para logs y timestamps (formato IANA)
TIMEZONE=America/Chicago

# WhatsApp Business Cloud API (opcional - notificaciones de trades)
# Crear app en https://developers.facebook.com/apps y configurar WhatsApp Business
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# WHATSAPP_ACCESS_TOKEN=tu_access_token
# WHATSAPP_TO_NUMBER=1234567890
