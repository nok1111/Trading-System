# === Alvora Trading Client — Environment Variables ===

# URL del Auth Server (OBLIGATORIO — sin esto el cliente no arranca)
AUTH_SERVER_URL=http://localhost:8000

# === Binance API Keys (locales, NUNCA tocan el cloud) ===
BROKER_PROVIDER=binance
BROKER_API_KEY=
BROKER_API_SECRET=
BINANCE_TESTNET=false

# === Trading Mode ===
# Options: backtest, paper, live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# === AI Provider Keys (locales) ===
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
AI_MODEL=gemini-2.0-flash

# === Symbols ===
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# === Database (SQLite local) ===
DATABASE_URL=sqlite:///./data/trading.db

# === Risk Management ===
MAX_POSITION_SIZE_PERCENT=10.0
MAX_RISK_PER_TRADE_PERCENT=2.0
MAX_DAILY_LOSS_PERCENT=10.0
MAX_OPEN_POSITIONS=20

# === Live Trading Safety ===
LIVE_MAX_ORDER_USD=500.0
LIVE_DAILY_LOSS_LIMIT_USD=100.0
LIVE_KILL_SWITCH=false

# === Telegram (opcional) ===
TELEGRAM_BOT_TOKEN=

# === Timezone ===
TIMEZONE=America/Chicago
