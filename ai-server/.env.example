# Alvora AI Server — Environment Variables

APP_ENV=development
LOG_LEVEL=INFO

# Service-to-service HMAC (must match trading-client REMOTE_AI_TOKEN)
HMAC_SECRET=change-me-in-production
HMAC_TIMESTAMP_WINDOW_SECONDS=300

# Auth Server URL for JWT validation
AUTH_SERVER_URL=http://localhost:8000

# LLM Providers
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_ECONOMIC=llama-3.1-8b-instant
GROQ_MODEL_MEDIUM=llama-3.3-70b-versatile
GROQ_MODEL_ADVANCED=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cache
CACHE_TTL_SECONDS=60

# CORS
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
